{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Issue hygiene audit report",
  "type": "object",
  "required": ["records", "issues", "error_count", "warning_count"],
  "properties": {
    "records": {"type": "array"},
    "issues": {"type": "array"},
    "error_count": {"type": "integer", "minimum": 0},
    "warning_count": {"type": "integer", "minimum": 0}
  }
}
