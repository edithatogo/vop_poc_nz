{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "vop_poc_nz result reproducibility manifest",
  "type": "object",
  "required": ["run_id", "created_at_utc", "script", "outputs"],
  "properties": {
    "run_id": {"type": "string", "minLength": 1},
    "created_at_utc": {"type": "string", "minLength": 1},
    "script": {"type": "string", "minLength": 1},
    "command": {"type": ["string", "null"]},
    "case_id": {"type": ["string", "null"]},
    "software_version": {"type": ["string", "null"]},
    "git_commit": {"type": ["string", "null"]},
    "random_seed": {"type": ["integer", "null"]},
    "inputs": {
      "type": "array",
      "items": {"$ref": "#/$defs/file_hash"}
    },
    "outputs": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/result_artifact"}
    },
    "parameters": {"type": "object"},
    "notes": {"type": ["string", "null"]}
  },
  "$defs": {
    "file_hash": {
      "type": "object",
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "role": {"type": "string"},
        "bytes": {"type": ["integer", "null"], "minimum": 0}
      }
    },
    "result_artifact": {
      "type": "object",
      "required": ["artifact_id", "path", "artifact_type", "sha256"],
      "properties": {
        "artifact_id": {"type": "string"},
        "path": {"type": "string"},
        "artifact_type": {"type": "string"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "bytes": {"type": ["integer", "null"], "minimum": 0},
        "derived_from": {"type": "array", "items": {"type": "string"}}
      }
    }
  }
}
