{
  "schema_version": "1.0",
  "max_public_fixture_bytes": 1000000,
  "public_fixture_globs": [
    "examples/**/*",
    "tests/fixtures/**/*",
    "tests/data/**/*",
    "docs/examples/**/*"
  ],
  "external_artifact_globs": [
    "artifacts/external/**/*",
    "data/external/**/*",
    "osf/**/*",
    "zenodo/**/*"
  ],
  "always_local_globs": [
    ".env*",
    ".conductor/local/**/*",
    "local/**/*",
    "private/**/*",
    "data/raw/**/*",
    "data/private/**/*",
    "reviewer_letters/**/*",
    "manuscripts/submissions/**/*",
    "outputs/local/**/*",
    "results/local/**/*",
    "artifacts/local/**/*"
  ],
  "manifest_required_globs": [
    "results/**/*",
    "outputs/**/*",
    "figures/**/*",
    "tables/**/*",
    "manuscripts/**/*",
    "data/**/*"
  ]
}
